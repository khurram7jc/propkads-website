# Copy to .env.local for local development.
# Add the SAME variables in Vercel: Project > Settings > Environment Variables

# From Neon Console > your project > Connection string (pooled connection recommended)
DATABASE_URL=postgres://user:password@ep-xxxxx.neon.tech/neondb?sslmode=require

# Any long random string — used to sign login sessions. Generate one, don't reuse elsewhere.
SESSION_SECRET=replace-with-a-long-random-string
